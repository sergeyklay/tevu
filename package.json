{
  "name": "tevu",
  "version": "0.1.0-rc.1",
  "description": "Task Evaluation & Verification Utility for AI coding agents",
  "keywords": [
    "ai",
    "llm",
    "cli",
    "agents",
    "benchmark",
    "evaluation"
  ],
  "homepage": "https://github.com/sergeyklay/tevu",
  "bugs": {
    "url": "https://github.com/sergeyklay/tevu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergeyklay/tevu.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Serghei Iakovlev",
    "email": "oss@serghei.pl",
    "url": "https://serghei.pl"
  },
  "type": "module",
  "bin": {
    "tevu": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tevu": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "rm -rf dist && esbuild src/index.ts --bundle --format=esm --platform=node --target=node24 --packages=external --outfile=dist/index.js",
    "prepack": "bun run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run knip && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "jsonc-parser": "^3.3.1",
    "p-limit": "^7.3.3",
    "stdin-discarder": "^0.3.2",
    "yaml": "^2.9.1",
    "yocto-spinner": "^1.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^24.13.6",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
